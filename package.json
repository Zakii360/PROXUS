{
  "name": "proxus",
  "version": "0.1.0",
  "description": "PROXUS \u2014 a privacy-focused web workspace with a proxied web viewer.",
  "author": "360Digital, Co.",
  "main": "electron/main.js",
  "homepage": "https://360-search.com",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux deb AppImage",
    "build:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.360digital.proxus",
    "productName": "PROXUS",
    "copyright": "Copyright \u00a9 2026 360Digital, Co.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "electron/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Network"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
